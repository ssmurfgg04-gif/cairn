{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cairn",
  "version": "4.0.0",
  "identifier": "studio.cairn.app",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src http://127.0.0.1:17778"
    },
    "trayIcon": null
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/cairn.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Version control for the folder your video editor already uses",
    "category": "Video"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cairn"
        ]
      }
    }
  }
}
